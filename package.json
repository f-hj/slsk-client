{
  "name": "slsk-client",
  "version": "2.0.0-beta.8",
  "description": "Soulseek NodeJS client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --noEmit",
    "test": "mocha 'test/*.test.ts'",
    "test:integration": "mocha 'test/integration/*.test.ts' --timeout 420000",
    "coverage": "c8 mocha 'test/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Florian Hermouet-Joscht",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-hj/slsk-client.git"
  },
  "keywords": [
    "slsk",
    "soulseek",
    "js-client",
    "socket",
    "typescript"
  ],
  "dependencies": {
    "debug": "^4.4.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "mocha": "^11.7.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
